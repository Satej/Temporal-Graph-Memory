NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=memorydemo
NEO4J_DATABASE=neo4j

# Extractor: rules (offline regexes) | llm (structured output via the gateway)
GRAPH_MEMORY_EXTRACTOR=rules
# Embedder: hashing (offline, lexical) | local (sentence-transformers, needs `uv sync --extra local`)
GRAPH_MEMORY_EMBEDDER=hashing
EMBEDDING_DIM=384
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

